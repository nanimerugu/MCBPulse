# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by both the app's PrismaClient
# (src/lib/db.ts, via @prisma/adapter-pg) and the Prisma CLI (prisma.config.ts).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mcbpulse?schema=public"

# Auth.js (next-auth v5). Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Base URL of this app, used by Auth.js for callback URLs.
AUTH_URL="http://localhost:3000"
