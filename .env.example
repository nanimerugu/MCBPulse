# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by both the app's PrismaClient
# (src/lib/db.ts, via @prisma/adapter-pg) and the Prisma CLI (prisma.config.ts).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mcbpulse?schema=public"

# Empty database `prisma migrate dev` uses to replay migration history and
# compute diffs. Must exist and must be a DIFFERENT database from DATABASE_URL.
# Only needed for `migrate dev` (local development); `migrate deploy` (CI/prod)
# does not use it.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mcbpulse_shadow?schema=public"

# Auth.js (next-auth v5). Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Base URL of this app, used by Auth.js for callback URLs.
AUTH_URL="http://localhost:3000"

# Scheduler (src/modules/scheduler). A platform cron — or `npm run scheduler`
# on a VM — calls /api/cron/tick every minute with
# `Authorization: Bearer $CRON_SECRET`. Without a secret of 32+ characters
# the endpoint refuses every call and nothing scheduled ever runs: held
# messages stay held, date-based reminders never go.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="replace-with-64-hex-characters"
# Where `npm run scheduler` rings. Defaults to http://localhost:3010/api/cron/tick.
# SCHEDULER_URL="https://school.example.com/api/cron/tick"

# The public base URL, used to build links in invitation and password-reset
# emails. Falls back to AUTH_URL. REQUIRED in production: a link is never
# built from the request's Host header (that header is attacker-controlled),
# and the app refuses to send a reset link rather than guess.
# APP_URL="https://school.example.com"
